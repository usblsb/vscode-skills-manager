{
  "name": "vscode-skills-manager",
  "displayName": "Gestor de Skills IA",
  "description": "Explora, gestiona, crea, sincroniza y usa Agent Skills en VS Code y Cursor.",
  "version": "1.4.1",
  "icon": "media/icon.png",
  "publisher": "usblsb",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usblsb/vscode-skills-manager"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skills-manager-container",
          "title": "Skills IA",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "skills-manager-container": [
        {
          "id": "skills-manager-tree",
          "name": "Habilidades Disponibles"
        }
      ]
    },
    "commands": [
      {
        "command": "skills-manager.buscar",
        "title": "Buscar y copiar Skill (@skill)",
        "category": "Skills IA",
        "icon": "$(search)"
      },
      {
        "command": "skills-manager.recargar",
        "title": "Recargar lista de Skills",
        "category": "Skills IA",
        "icon": "$(refresh)"
      },
      {
        "command": "skills-manager.sincronizar",
        "title": "Sincronizar Skills desde GitHub",
        "category": "Skills IA",
        "icon": "$(cloud-download)"
      },
      {
        "command": "skills-manager.ocultarInactivas",
        "title": "Ocultar habilidades inactivas",
        "category": "Skills IA",
        "icon": "$(eye-closed)"
      },
      {
        "command": "skills-manager.mostrarInactivas",
        "title": "Mostrar habilidades inactivas",
        "category": "Skills IA",
        "icon": "$(eye)"
      },
      {
        "command": "skills-manager.marcarFavorita",
        "title": "Marcar como favorita",
        "category": "Skills IA",
        "icon": "$(star-empty)"
      },
      {
        "command": "skills-manager.desmarcarFavorita",
        "title": "Quitar de favoritas",
        "category": "Skills IA",
        "icon": "$(star-full)"
      },
      {
        "command": "skills-manager.abrirSkill",
        "title": "Ver documentacion (SKILL.md)",
        "category": "Skills IA",
        "icon": "$(file-text)"
      },
      {
        "command": "skills-manager.copiarMencion",
        "title": "Copiar @mencion de la Skill",
        "category": "Skills IA",
        "icon": "$(clippy)"
      },
      {
        "command": "skills-manager.desactivarSkill",
        "title": "Desactivar habilidad",
        "category": "Skills IA",
        "icon": "$(circle-slash)"
      },
      {
        "command": "skills-manager.activarSkill",
        "title": "Activar habilidad",
        "category": "Skills IA",
        "icon": "$(pass)"
      },
      {
        "command": "skills-manager.copiarRuta",
        "title": "Copiar ruta de la carpeta",
        "category": "Skills IA",
        "icon": "$(copy)"
      },
      {
        "command": "skills-manager.crearSkill",
        "title": "Crear nueva habilidad",
        "category": "Skills IA",
        "icon": "$(add)"
      },
      {
        "command": "skills-manager.instalarSkill",
        "title": "Añadir a mis habilidades",
        "category": "Skills IA",
        "icon": "$(plus)"
      },
      {
        "command": "skills-manager.eliminarSkill",
        "title": "Eliminar habilidad",
        "category": "Skills IA",
        "icon": "$(trash)"
      },
      {
        "command": "skills-manager.consolidarGlobales",
        "title": "Consolidar y sincronizar Skills Globales",
        "category": "Skills IA",
        "icon": "$(layers)"
      },
      {
        "command": "skills-manager.copiarALocal",
        "title": "Copiar a Local (Workspace)",
        "category": "Skills IA",
        "icon": "$(folder)"
      },
      {
        "command": "skills-manager.copiarAClaude",
        "title": "Copiar a Claude Code (.claude/skills)",
        "category": "Skills IA",
        "icon": "$(hubot)"
      },
      {
        "command": "skills-manager.copiarAGlobal",
        "title": "Copiar a Global (Universal)",
        "category": "Skills IA",
        "icon": "$(globe)"
      },
      {
        "command": "skills-manager.desplegarEnAgente",
        "title": "Desplegar en Agente...",
        "category": "Skills IA",
        "icon": "$(hubot)"
      },
      {
        "command": "skills-manager.copiarABackup",
        "title": "Guardar en Baúl de Referencia",
        "category": "Skills IA",
        "icon": "$(archive)"
      },
      {
        "command": "skills-manager.respaldarTodo",
        "title": "Respaldar todas las Skills en el Baúl",
        "category": "Skills IA",
        "icon": "$(archive)"
      }
    ],
    "keybindings": [
      {
        "command": "skills-manager.buscar",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "skills-manager.crearSkill",
          "when": "view == skills-manager-tree",
          "group": "navigation@1"
        },
        {
          "command": "skills-manager.buscar",
          "when": "view == skills-manager-tree",
          "group": "navigation@2"
        },
        {
          "command": "skills-manager.ocultarInactivas",
          "when": "view == skills-manager-tree && !skillsManager.ocultarInactivas",
          "group": "navigation@3"
        },
        {
          "command": "skills-manager.mostrarInactivas",
          "when": "view == skills-manager-tree && skillsManager.ocultarInactivas",
          "group": "navigation@3"
        },
        {
          "command": "skills-manager.recargar",
          "when": "view == skills-manager-tree",
          "group": "navigation@4"
        },
        {
          "command": "skills-manager.sincronizar",
          "when": "view == skills-manager-tree",
          "group": "navigation@5"
        },
        {
          "command": "skills-manager.respaldarTodo",
          "when": "view == skills-manager-tree",
          "group": "navigation@6"
        },
        {
          "command": "skills-manager.consolidarGlobales",
          "when": "view == skills-manager-tree",
          "group": "navigation@7"
        }
      ],
      "view/item/context": [
        {
          "command": "skills-manager.instalarSkill",
          "when": "view == skills-manager-tree && viewItem =~ /^skillItem_catalogo/",
          "group": "inline@1"
        },
        {
          "command": "skills-manager.copiarALocal",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_backup/ || viewItem =~ /^skillItem_global/ || viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/)",
          "group": "inline@1"
        },
        {
          "command": "skills-manager.copiarAGlobal",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_backup/ || viewItem =~ /^skillItem_global/ || viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/)",
          "group": "inline@2"
        },
        {
          "command": "skills-manager.marcarFavorita",
          "when": "view == skills-manager-tree && viewItem =~ /_nofav_/",
          "group": "inline@3"
        },
        {
          "command": "skills-manager.desmarcarFavorita",
          "when": "view == skills-manager-tree && viewItem =~ /_fav_/",
          "group": "inline@3"
        },
        {
          "command": "skills-manager.copiarMencion",
          "when": "view == skills-manager-tree && viewItem =~ /^skillItem/",
          "group": "inline@4"
        },
        {
          "command": "skills-manager.abrirSkill",
          "when": "view == skills-manager-tree && viewItem =~ /^skillItem/",
          "group": "inline@5"
        },
        {
          "command": "skills-manager.eliminarSkill",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/ || viewItem =~ /^skillItem_global/ || viewItem =~ /^skillItem_backup/)",
          "group": "inline@6"
        },
        {
          "command": "skills-manager.copiarALocal",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_backup/ || viewItem =~ /^skillItem_global/ || viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/)",
          "group": "0_transfer@1"
        },
        {
          "command": "skills-manager.copiarAClaude",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_backup/ || viewItem =~ /^skillItem_global/ || viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/)",
          "group": "0_transfer@1.5"
        },
        {
          "command": "skills-manager.copiarAGlobal",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_backup/ || viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/ || viewItem =~ /^skillItem_global/)",
          "group": "0_transfer@2"
        },
        {
          "command": "skills-manager.desplegarEnAgente",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_backup/ || viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/ || viewItem =~ /^skillItem_global/)",
          "group": "0_transfer@2.5"
        },
        {
          "command": "skills-manager.copiarABackup",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/ || viewItem =~ /^skillItem_global/)",
          "group": "0_transfer@3"
        },
        {
          "command": "skills-manager.desactivarSkill",
          "when": "view == skills-manager-tree && viewItem =~ /_activa$/",
          "group": "1_state@1"
        },
        {
          "command": "skills-manager.activarSkill",
          "when": "view == skills-manager-tree && viewItem =~ /_inactiva$/",
          "group": "1_state@1"
        },
        {
          "command": "skills-manager.copiarRuta",
          "when": "view == skills-manager-tree && viewItem =~ /^skillItem/",
          "group": "2_paths@1"
        },
        {
          "command": "skills-manager.eliminarSkill",
          "when": "view == skills-manager-tree && (viewItem =~ /^skillItem_propia/ || viewItem =~ /^skillItem_workspace/ || viewItem =~ /^skillItem_global/ || viewItem =~ /^skillItem_backup/)",
          "group": "3_danger@1"
        }
      ]
    },
    "configuration": {
      "title": "Gestor de Skills IA",
      "properties": {
        "skillsManager.ownSkillsPath": {
          "type": "string",
          "default": ".agents/skills",
          "description": "Carpeta donde se guardan tus habilidades de proyecto (relativa al proyecto o ruta absoluta)."
        },
        "skillsManager.claudeSkillsPath": {
          "type": "string",
          "default": ".claude/skills",
          "description": "Carpeta donde se guardan las habilidades para Claude Code en el proyecto (por defecto '.claude/skills')."
        },
        "skillsManager.globalSkillsPath": {
          "type": "string",
          "default": "~/.agents/skills",
          "description": "Carpeta global donde guardar habilidades para todos los proyectos (por defecto '~/.agents/skills')."
        },
        "skillsManager.backupSkillsPath": {
          "type": "string",
          "default": "~/.skills-backup",
          "description": "Carpeta privada tipo baúl/backup donde resguardar todas tus habilidades de referencia."
        },
        "skillsManager.globalSearchFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/.agents/skills",
            "~/.gemini/config/skills",
            "~/.claude/skills",
            "~/.cursor/skills"
          ],
          "description": "Carpetas globales en tu máquina donde buscar skills (compatible con Antigravity, Cursor, Claude Code y terminal)."
        },
        "skillsManager.remoteSkillsPath": {
          "type": "string",
          "default": "skills-remotas",
          "description": "Carpeta donde se sincroniza el catálogo remoto de GitHub (relativa al proyecto o ruta absoluta)."
        },
        "skillsManager.githubRepoUrl": {
          "type": "string",
          "default": "https://github.com/davidondrej/skills.git",
          "description": "URL del repositorio GitHub para sincronizar las skills del catálogo remoto."
        },
        "skillsManager.workspaceFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".agents/skills",
            ".agent/skills",
            ".gemini/skills",
            ".claude/skills"
          ],
          "description": "Carpetas relativas dentro del espacio de trabajo donde buscar skills locales."
        },
        "skillsManager.mentionPrefix": {
          "type": "string",
          "default": "/",
          "description": "Prefijo utilizado al copiar el comando de la skill (por defecto '/' para Slash Command)."
        },
        "skillsManager.agentesActivos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "auto"
          ],
          "description": "Lista de agentes de IA activos para la extensión. Por defecto ['auto'] detecta automáticamente las herramientas instaladas en tu sistema."
        },
        "skillsManager.usarEnlacesSimbolicos": {
          "type": "boolean",
          "default": false,
          "description": "Si está activo, al desplegar habilidades en otros agentes se crearán enlaces simbólicos (symlinks) en lugar de duplicar archivos."
        }
      }
    }
  },
  "scripts": {
    "lint": "node -e 'console.log(\"Sintaxis OK\")'",
    "test": "node test/test_loader.js && node test/test_state.js && node test/test_tree_and_quickpick.js && node test/test_actions.js && node test/test_agent_registry.js",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0"
  }
}
